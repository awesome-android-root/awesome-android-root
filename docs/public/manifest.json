{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",

  "id": "/",
  "name": "Awesome Android Root",
  "short_name": "Android Root",
  "description": "The ultimate collection of Android rooting apps, Magisk modules, KernelSU modules, recoveries, kernels, and developer resources.",

  "lang": "en",
  "dir": "ltr",

  "start_url": "/",
  "scope": "/",

  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],

  "orientation": "portrait",

  "theme_color": "#0b0b0c",
  "background_color": "#0b0b0c",

  "categories": [
    "developer",
    "utilities",
    "productivity",
    "education"
  ],

  "icons": [
    {
      "src": "/images/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/images/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/images/maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/images/maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "App Index",
      "short_name": "App Index",
      "description": "Browse all root apps and modules by category",
      "url": "/apps-and-modules",
      "icons": [{ "src": "/favicon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Rooting Guides",
      "short_name": "Guides",
      "description": "Step-by-step rooting guides for popular devices",
      "url": "/rooting-guides",
      "icons": [{ "src": "/favicon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Troubleshooting",
      "short_name": "Fixes",
      "description": "Fix common rooting problems",
      "url": "/troubleshooting",
      "icons": [{ "src": "/favicon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
