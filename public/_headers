# Cloudflare Pages custom headers — Awesome Android Root
# (migrated from the VitePress setup; paths updated for Astro's output)

# -----------------------------------------------------------------------------
# Service Worker - MUST never be cached by browser or CDN.
# Without this Cloudflare's default caching breaks SW updates entirely.
# -----------------------------------------------------------------------------
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=UTF-8

# Workbox runtime chunks (generated alongside sw.js)
/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate

# -----------------------------------------------------------------------------
# PWA Manifest - keep fresh so installs reflect latest metadata.
# -----------------------------------------------------------------------------
/manifest.json
  Cache-Control: no-cache
  Content-Type: application/manifest+json; charset=UTF-8

# -----------------------------------------------------------------------------
# Astro hashed assets - filename includes content hash → immutable.
# 1-year TTL + immutable = zero revalidation cost from Cloudflare edge.
# -----------------------------------------------------------------------------
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# -----------------------------------------------------------------------------
# Public images - no content hash in filename, so allow revalidation.
# -----------------------------------------------------------------------------
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# -----------------------------------------------------------------------------
# Pagefind search index - core files revalidate; content-addressed fragments
# cache well.
# -----------------------------------------------------------------------------
/pagefind/pagefind.js
  Cache-Control: no-cache

/pagefind/meta.json
  Cache-Control: no-cache

/pagefind/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# -----------------------------------------------------------------------------
# LLM / Markdown exports - short-lived so updates propagate quickly.
# -----------------------------------------------------------------------------
/llms.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/llms-full.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.md
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: text/markdown; charset=UTF-8

# -----------------------------------------------------------------------------
# Global security headers applied to every response
# -----------------------------------------------------------------------------
/*
  # Clickjacking protection
  X-Frame-Options: DENY

  # Prevent MIME-type sniffing attacks
  X-Content-Type-Options: nosniff

  # Disable the legacy XSS filter - it can *introduce* XSS vulnerabilities
  # in some browsers. Modern browsers rely on CSP instead.
  X-XSS-Protection: 0

  # Restrict browser feature access
  Permissions-Policy: camera=(), microphone=(), geolocation=()

  # HSTS - 2-year max-age satisfies the HSTS preload list minimum requirement
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Send origin-only on cross-origin requests; full URL on same-origin
  Referrer-Policy: strict-origin-when-cross-origin

  # Protects against cross-origin window access while allowing outbound
  # popups needed for GitHub / Play Store / F-Droid links
  Cross-Origin-Opener-Policy: same-origin-allow-popups
