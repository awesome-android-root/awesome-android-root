{
  "name": "awesome-android-root",
  "version": "6.2.0",
  "description": "A curated collection of 800+ Android root apps, Magisk, KernelSU, APatch and LSPosed modules, with step-by-step rooting guides.",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.5",
  "author": {
    "name": "awesome-android-root",
    "url": "https://github.com/awesome-android-root"
  },
  "homepage": "https://awesome-android-root.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/awesome-android-root/awesome-android-root.git"
  },
  "bugs": {
    "url": "https://github.com/awesome-android-root/awesome-android-root/issues"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "bun scripts/prepare-build.ts && bun run index:build && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:links": "bun scripts/check-links.ts",
    "test": "bun test scripts/*.test.ts",
    "index:build": "bun scripts/app-entries.ts",
    "check": "bun run typecheck && bun run test && bun run lint && bun run docs:build && bun run test:search",
    "typecheck": "bun check --no-script -p tsconfig.browser.json && bun check --no-script -p tsconfig.tools.json && bun check --no-script -p tsconfig.worker.json && bun check --no-script -p tsconfig.tests.json",
    "test:search": "bun test tests/search.spec.ts",
    "lint": "bun run check:links && bun run lint:entries",
    "lint:entries": "bun scripts/app-entries.ts --check"
  },
  "keywords": [
    "android",
    "android-root",
    "root",
    "rooting",
    "root-guide",
    "magisk",
    "magisk-modules",
    "kernelsu",
    "kernelsu-modules",
    "apatch",
    "apatch-modules",
    "lsposed",
    "lsposed-modules",
    "xposed",
    "zygisk",
    "play-integrity",
    "bootloader-unlock",
    "android-apps",
    "android-tools",
    "awesome-list",
    "awesome",
    "pwa",
    "vitepress"
  ],
  "devDependencies": {
    "@lucide/vue": "^1.81.0",
    "@types/bun": "^1.4.5",
    "@types/markdown-it": "^14.2.0",
    "@vite-pwa/vitepress": "^2.0.5",
    "magicast": "^0.5.5",
    "pagefind": "^1.6.0",
    "puppeteer-core": "^25.19.0",
    "vite": "^8.4.0",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-llms": "^1.15.0",
    "vue": "^3.5.46"
  },
  "engines": {
    "node": ">=26"
  },
  "type": "module"
}
