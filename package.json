{
  "name": "awesome-android-root",
  "version": "5.1.0",
  "description": "The ultimate Android rooting hub - a curated list of 750++ top root apps, Magisk modules, KernelSU modules, LSPosed modules, and comprehensive step-by-step rooting guides.",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "author": {
    "name": "awesome-android-root",
    "url": "https://github.com/awesome-android-root"
  },
  "homepage": "https://awesome-android-root.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/awesome-android-root/awesome-android-root.git"
  },
  "bugs": {
    "url": "https://github.com/awesome-android-root/awesome-android-root/issues"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "sh -c 'if [ -f .git/shallow ]; then git fetch --unshallow || true; fi' && npm run index:build && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:links": "python3 scripts/check_links.py",
    "index:build": "node scripts/app-entries.mjs"
  },
  "keywords": [
    "android",
    "root",
    "magisk",
    "magisk-modules",
    "kernelsu",
    "kernelsu-modules",
    "lsposed",
    "lsposed-modules",
    "xposed",
    "xposed-modules",
    "rooting",
    "root-guide",
    "android-apps",
    "android-tools",
    "awesome-list",
    "awesome",
    "pwa",
    "vitepress"
  ],
  "devDependencies": {
    "@lucide/vue": "^1.61.0",
    "@vite-pwa/vitepress": "^1.1.0",
    "simple-icons": "^16.35.0",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-llms": "^1.14.0",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=24"
  }
}
