{
  "name": "awesome-android-root",
  "version": "5.1.0",
  "description": "A curated index of Android root apps and modules, with practical rooting guides, tutorials, and troubleshooting references.",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "author": {
    "name": "awesome-android-root",
    "url": "https://github.com/awesome-android-root"
  },
  "homepage": "https://awesome-android-root.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/awesome-android-root/awesome-android-root.git"
  },
  "bugs": {
    "url": "https://github.com/awesome-android-root/awesome-android-root/issues"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "test": "node --test scripts/*.test.mjs",
    "docs:build": "bash scripts/counter.sh && vitepress build docs && node scripts/verify-site-build.mjs && python3 scripts/check-asset-budgets.py && python3 scripts/check-built-links.py",
    "docs:preview": "vitepress preview docs",
    "docs:verify": "node scripts/verify-site-build.mjs && python3 scripts/check-asset-budgets.py && python3 scripts/check-built-links.py"
  },
  "keywords": [
    "android",
    "root",
    "magisk",
    "magisk-modules",
    "kernelsu",
    "kernelsu-modules",
    "lsposed",
    "lsposed-modules",
    "xposed",
    "xposed-modules",
    "rooting",
    "root-guide",
    "android-apps",
    "android-tools",
    "awesome-list",
    "awesome",
    "pwa",
    "vitepress"
  ],
  "devDependencies": {
    "@vite-pwa/vitepress": "^1.1.0",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-llms": "^1.14.0",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=24"
  }
}
