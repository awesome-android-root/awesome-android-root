---
/** Back-to-top button — vanilla JS port of the old BackToTop.vue. */
---

<button class="back-to-top" type="button" aria-label="Back to top" title="Back to top" hidden>
	<svg
		width="20"
		height="20"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"><path d="M5 15l7-7 7 7"></path></svg>
</button>

<script>
	const button = document.querySelector<HTMLButtonElement>('.back-to-top');
	if (button) {
		let ticking = false;
		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			window.requestAnimationFrame(() => {
				button.hidden = window.scrollY <= 450;
				ticking = false;
			});
		};
		button.addEventListener('click', () => {
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			window.scrollTo(reduced ? { top: 0 } : { top: 0, behavior: 'smooth' });
		});
		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();
	}
</script>

<style>
	.back-to-top {
		position: fixed;
		bottom: 2rem;
		right: 1.25rem;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--sl-color-accent);
		color: var(--sl-color-bg);
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--sl-color-accent-high);
		cursor: pointer;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
		transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
		z-index: 30;
	}
	.back-to-top[hidden] {
		display: none;
	}
	.back-to-top:hover {
		background: var(--sl-color-accent-high);
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
		transform: translateY(-2px);
	}
	.back-to-top:focus-visible {
		outline: 3px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
	@media (max-width: 640px) {
		.back-to-top {
			bottom: 1.25rem;
			right: 1rem;
			width: 40px;
			height: 40px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.back-to-top {
			transition: none;
		}
	}
</style>
