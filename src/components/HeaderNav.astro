	<ul class="aar-nav-list">
		<li><a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a></li>
		<li>
			<a href="/apps-and-modules" aria-current={isActive('/apps-and-modules') ? 'page' : undefined}>Apps &amp; Modules</a>
