---
/**
 * Top-level section navigation, ported from the old VitePress `nav` config.
 * Desktop-only; on small screens the (full) sidebar is available via
 * Starlight's mobile menu. Implemented with disclosure widgets so it
 * works with keyboard and screen readers without client JavaScript.
 */
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (href: string) => {
	const h = href.replace(/\/$/, '') || '/';
	return currentPath === h || currentPath.startsWith(h + '/');
};
---

