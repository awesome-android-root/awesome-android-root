---
/** Site-wide footer links + copyright (ported from the VitePress footer). */
interface Props {
	year: number;
}
const { year } = Astro.props;
---

<div class="aar-site-footer">
	<nav aria-label="Footer">
		<a href="/contributing">Contribute</a>
		<span class="sep" aria-hidden="true">•</span>
		<a href="/legal-disclaimer">Legal</a>
		<span class="sep" aria-hidden="true">•</span>
		<a href="https://github.com/awesome-android-root/awesome-android-root" target="_blank" rel="noopener noreferrer">GitHub</a>
		<span class="sep" aria-hidden="true">•</span>
		<a href="https://x.com/awsm_and_root" target="_blank" rel="noopener noreferrer">Twitter/X</a>
	</nav>
	<p class="copyright">Copyright © {year} Awesome Android Root Project</p>
</div>

<style>
	.aar-site-footer {
		margin-top: 2.5rem;
		padding: 2rem 0 1rem;
		border-top: 1px solid var(--sl-color-hairline);
		text-align: center;
		font-size: var(--sl-text-sm);
	}
	.aar-site-footer nav {
		display: flex;
		gap: 0.75rem;
		justify-content: center;
		flex-wrap: wrap;
		align-items: center;
		margin-bottom: 0.5rem;
	}
	.aar-site-footer a {
		color: var(--sl-color-gray-2);
		font-weight: 500;
		text-decoration: none;
	}
	.aar-site-footer a:hover {
		color: var(--sl-color-text-accent);
	}
	.aar-site-footer a:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
		border-radius: 2px;
	}
	.sep {
		color: var(--sl-color-gray-4);
	}
	.copyright {
		margin: 0;
		color: var(--sl-color-gray-3);
	}
</style>
