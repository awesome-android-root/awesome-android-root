---
/**
 * Custom 404 page (replaces the old docs/404.md VitePress page). Keeps the
 * same title, message and quick links, rendered inside the Starlight layout
 * with noindex meta so error pages stay out of search indexes.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: '404 - Page Not Found',
		description: 'The page you are looking for could not be found.',
		pagefind: false,
		editUrl: false,
		lastUpdated: false,
		template: 'splash',
	}}
	head={[{ tag: 'meta', attrs: { name: 'robots', content: 'noindex, follow' } }]}
>
	<div class="sl-flex" style="flex-direction: column; gap: 1rem; padding: 2rem 0;">
		<p>
			The page you are looking for doesn't exist or has moved. Try one of these
			instead:
		</p>
		<ul style="display: flex; flex-direction: column; gap: 0.5rem; list-style: none; padding: 0;">
			<li><a href="/">🏠 Home</a></li>
			<li><a href="/rooting-guides">📖 Complete Rooting Guide</a></li>
			<li><a href="/apps-and-modules">🧰 Browse Root Apps &amp; Modules</a></li>
			<li><a href="/troubleshooting">🔧 Troubleshooting Guide</a></li>
			<li><a href="/faqs">❓ FAQ</a></li>
		</ul>
	</div>
</StarlightPage>
